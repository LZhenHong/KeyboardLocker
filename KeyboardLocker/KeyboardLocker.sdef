<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="KeyboardLocker">
  <suite name="KeyboardLocker Suite" code="KBLR" description="Commands for controlling KeyboardLocker.">
    <command name="lock keyboard" code="KBLRlock" description="Lock standard keyboard input.">
      <cocoa class="LockKeyboardScriptCommand"/>
    </command>
    <command name="unlock keyboard" code="KBLRunlk" description="Unlock standard keyboard input.">
      <cocoa class="UnlockKeyboardScriptCommand"/>
    </command>
    <command name="get keyboard lock status" code="KBLRstat" description="Return whether standard keyboard input is currently locked.">
      <cocoa class="GetKeyboardLockStatusScriptCommand"/>
      <result type="boolean" description="true when standard keyboard input is locked; otherwise false."/>
    </command>
  </suite>
</dictionary>
